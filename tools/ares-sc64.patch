diff --git a/ares/n64/cartridge/sc64.cpp b/ares/n64/cartridge/sc64.cpp
new file mode 100644
index 0000000..0005947
--- /dev/null
+++ b/ares/n64/cartridge/sc64.cpp
@@ -0,0 +1,72 @@
+// SummerCart64 emulation (registers and writable SDRAM), enough for software
+// that pages memory to the cartridge: key unlock, "SCv2" identifier and
+// CONFIG_SET(ROM_WRITE_ENABLE). Enabling writes extends the ROM buffer to the
+// SC64's 64 MiB of SDRAM (less the IS-Viewer window at 0x13ff'0000).
+
+auto Cartridge::SC64::piAddress(u32 address, PIDeviceTiming) -> bool {
+  if(address < 0x1fff'0000 || address >= 0x1fff'0020) return false;
+  piAddr = address & 0x1f;
+  return true;
+}
+
+auto Cartridge::SC64::readRegister(u32 reg) -> u32 {
+  switch(reg) {
+  case 0x00: return status;
+  case 0x04: return data0;
+  case 0x08: return data1;
+  case 0x0c: return unlocked ? 0x5343'7632 : 0;   // "SCv2"
+  }
+  return 0;
+}
+
+auto Cartridge::SC64::writeRegister(u32 reg, u32 value) -> void {
+  if(reg == 0x10) {                                // KEY
+    if(value == 0) { keyStage = 0; unlocked = 0; return; }
+    if(keyStage == 0 && value == 0x5f55'4e4c) { keyStage = 1; return; }
+    if(keyStage == 1 && value == 0x4f43'4b5f) { keyStage = 2; unlocked = 1; return; }
+    keyStage = 0;
+    return;
+  }
+  if(!unlocked) return;
+  if(reg == 0x04) { data0 = value; return; }
+  if(reg == 0x08) { data1 = value; return; }
+  if(reg == 0x00) {                                // command
+    status = 0;
+    if((value & 0xff) == 'C' && data0 == 1) {      // CONFIG_SET ROM_WRITE_ENABLE
+      u32 previous = romWritable;
+      romWritable = data1 != 0;
+      if(romWritable) self.extendRomToSdram();
+      data0 = 0;
+      data1 = previous;
+      return;
+    }
+    if((value & 0xff) == 'c' && data0 == 1) {      // CONFIG_GET ROM_WRITE_ENABLE
+      data0 = 0;
+      data1 = romWritable;
+      return;
+    }
+    status = 1u << 30;                             // unsupported: error flag
+  }
+}
+
+auto Cartridge::SC64::piReadHalf(PIDeviceTiming) -> maybe<u16> {
+  u32 word = readRegister(piAddr & ~3u);
+  u16 half = (piAddr & 2) ? u16(word) : u16(word >> 16);
+  piAddr += 2;
+  return half;
+}
+
+auto Cartridge::SC64::piWriteHalf(u16 data, PIDeviceTiming) -> void {
+  pi.writeForceFinish();
+  if(!(piAddr & 2)) latch = data;
+  else writeRegister(piAddr & ~3u, u32(latch) << 16 | data);
+  piAddr += 2;
+}
+
+auto Cartridge::extendRomToSdram() -> void {
+  const u32 sdram = 0x03ff'0000;
+  if(rom.size >= sdram) return;
+  std::vector<u8> old((u8*)rom.data, (u8*)rom.data + rom.size);
+  rom.allocate(sdram, 0);
+  memory::copy(rom.data, old.data(), old.size());
+}
