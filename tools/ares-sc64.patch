index 0000000..bce2c53
--- /dev/null
+++ b/ares/n64/cartridge/sc64.cpp
@@ -0,0 +1,169 @@
+// SummerCart64 emulation: enough for homebrew that uses the cartridge's
+// SDRAM as writable memory and its SD card as storage.
+//
+//  - registers at 0x1fff'0000 (STATUS/COMMAND, DATA0, DATA1, IDENTIFIER, KEY),
+//    unlocked with the "_UNL" "OCK_" key sequence, identifier "SCv2";
+//  - CONFIG_SET/GET: ROM_WRITE_ENABLE (writable SDRAM; enabling it extends the
+//    ROM buffer to 64 MiB less the IS-Viewer window at 0x13ff'0000), other
+//    options read as 0;
+//  - SD card: SD_OP (init, deinit, status, info, byteswap), SD_SECTOR_SET,
+//    SD_READ / SD_WRITE to the 8 KiB data buffer at 0x1ffe'0000 or to SDRAM.
+//    The card is a raw disk image named by the SC64_SD_IMAGE environment
+//    variable (writes go to the file).
+
+auto Cartridge::SC64::piAddress(u32 address, PIDeviceTiming) -> bool {
+  if(address >= 0x1fff'0000 && address < 0x1fff'0020) { piAddr = address; return true; }
+  if(address >= 0x1ffe'0000 && address < 0x1ffe'2000) { piAddr = address; return true; }
+  return false;
+}
+
+auto Cartridge::SC64::readRegister(u32 reg) -> u32 {
+  switch(reg) {
+  case 0x00: return status;
+  case 0x04: return data0;
+  case 0x08: return data1;
+  case 0x0c: return unlocked ? 0x5343'7632 : 0;   // "SCv2"
+  }
+  return 0;
+}
+
+auto Cartridge::SC64::sdOpen() -> bool {
+  if(sdFile) return true;
+  const char* path = getenv("SC64_SD_IMAGE");
+  if(!path || !*path) return false;
+  sdFile = fopen(path, "r+b");
+  if(!sdFile) sdFile = fopen(path, "rb");
+  if(!sdFile) return false;
+  fseeko(sdFile, 0, SEEK_END);
+  sdSectors = u64(ftello(sdFile)) / 512;
+  return true;
+}
+
+// Byte of cartridge address space the SD card can transfer to/from.
+auto Cartridge::SC64::byteAt(u32 address) -> u8* {
+  if(address >= 0x1ffe'0000 && address < 0x1ffe'2000) return &buffer[address - 0x1ffe'0000];
+  if(address >= 0x1000'0000 && address < 0x1400'0000) {
+    u32 offset = address - 0x1000'0000;
+    if(offset >= self.rom.size) return nullptr;
+    return (u8*)self.rom.data + (offset ^ 3);       // ROM words are stored host-endian
+  }
+  return nullptr;
+}
+
+auto Cartridge::SC64::sdTransfer(bool write, u32 address, u32 count) -> bool {
+  if(!sdFile || !sdInitialized) return false;
+  if(u64(sdSector) + count > sdSectors) return false;
+  u8 sector[512];
+  for(u32 n = 0; n < count; n++) {
+    fseeko(sdFile, off_t(u64(sdSector) * 512), SEEK_SET);
+    if(!write) {
+      if(fread(sector, 1, 512, sdFile) != 512) return false;
+      for(u32 i = 0; i < 512; i++) {
+        u8* p = byteAt(address + n * 512 + (sdByteswap ? (i ^ 1) : i));
+        if(!p) return false;
+        *p = sector[i];
+      }
+    } else {
+      for(u32 i = 0; i < 512; i++) {
+        u8* p = byteAt(address + n * 512 + i);
+        if(!p) return false;
+        sector[i] = *p;
+      }
+      if(fwrite(sector, 1, 512, sdFile) != 512) return false;
+    }
+    sdSector++;
+  }
+  if(write) fflush(sdFile);
+  return true;
+}
+
+auto Cartridge::SC64::writeRegister(u32 reg, u32 value) -> void {
+  if(reg == 0x10) {                                // KEY
+    if(value == 0) { keyStage = 0; unlocked = 0; return; }
+    if(value == 0xffff'ffff) { keyStage = 0; unlocked = 0; return; }
+    if(keyStage == 0 && value == 0x5f55'4e4c) { keyStage = 1; return; }
+    if(keyStage == 1 && value == 0x4f43'4b5f) { keyStage = 2; unlocked = 1; return; }
+    keyStage = 0;
+    return;
+  }
+  if(!unlocked) return;
+  if(reg == 0x04) { data0 = value; return; }
+  if(reg == 0x08) { data1 = value; return; }
+  if(reg != 0x00) return;
+
+  status = 0;
+  bool ok = true;
+  switch(value & 0xff) {
+  case 'C':                                        // CONFIG_SET
+    if(data0 == 1) {                               // ROM_WRITE_ENABLE
+      u32 previous = romWritable;
+      romWritable = data1 != 0;
+      if(romWritable) self.extendRomToSdram();
+      data1 = previous;
+    } else {
+      data1 = 0;
+    }
+    break;
+  case 'c':                                        // CONFIG_GET
+    data1 = (data0 == 1) ? u32(romWritable) : 0;
+    break;
+  case 'i':                                        // SD_OP
+    switch(data1) {
+    case 0: sdInitialized = 0; data1 = 0; break;   // deinit
+    case 1: ok = sdOpen(); sdInitialized = ok; data1 = 0; break;
+    case 2: data1 = (sdOpen() ? 1 : 0) | (sdInitialized ? 2 : 0); break;
+    case 3: data1 = 0; break;                      // card info (CSD/CID): not provided
+    case 4: sdByteswap = 1; data1 = 0; break;
+    case 5: sdByteswap = 0; data1 = 0; break;
+    default: ok = false;
+    }
+    break;
+  case 'I':                                        // SD_SECTOR_SET
+    sdSector = data0;
+    break;
+  case 's':                                        // SD_READ (to buffer or SDRAM)
+    ok = sdTransfer(false, data0, data1);
+    break;
+  case 'S':                                        // SD_WRITE (from buffer or SDRAM)
+    ok = sdTransfer(true, data0, data1);
+    break;
+  default:
+    ok = false;
+  }
+  if(!ok) status = 1u << 30;                       // error flag
+}
+
+auto Cartridge::SC64::piReadHalf(PIDeviceTiming) -> maybe<u16> {
+  u16 half;
+  if(piAddr >= 0x1ffe'0000 && piAddr < 0x1ffe'2000) {
+    u32 o = piAddr - 0x1ffe'0000;
+    half = u16(buffer[o]) << 8 | buffer[o + 1];
+  } else {
+    u32 word = readRegister(piAddr & 0x1c);
+    half = (piAddr & 2) ? u16(word) : u16(word >> 16);
+  }
+  piAddr += 2;
+  return half;
+}
+
+auto Cartridge::SC64::piWriteHalf(u16 data, PIDeviceTiming) -> void {
+  pi.writeForceFinish();
+  if(piAddr >= 0x1ffe'0000 && piAddr < 0x1ffe'2000) {
+    u32 o = piAddr - 0x1ffe'0000;
+    buffer[o] = data >> 8;
+    buffer[o + 1] = data;
+  } else if(!(piAddr & 2)) {
+    latch = data;
+  } else {
+    writeRegister(piAddr & 0x1c, u32(latch) << 16 | data);
+  }
+  piAddr += 2;
+}
+
+auto Cartridge::extendRomToSdram() -> void {
+  const u32 sdram = 0x03ff'0000;
+  if(rom.size >= sdram) return;
+  std::vector<u8> old((u8*)rom.data, (u8*)rom.data + rom.size);
+  rom.allocate(sdram, 0);
+  memory::copy(rom.data, old.data(), old.size());
+}
